              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "frame": { "showTitle": true, "title": "Batteries in catalog" },
              "encodings": { "value": { "fieldName": "batteries", "displayName": "Batteries" } }
            }
          },
          "position": { "x": 0, "y": 0, "width": 1, "height": 3 }
        },
        {
