{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "KPIs",
      "queryLines": [
        "SELECT COUNT(*) AS batteries, SUM(CASE WHEN is_pack THEN 1 ELSE 0 END) AS packs, (SELECT COUNT(*) FROM ups_batteries.gold.device_lookup) AS device_pairs, (SELECT COUNT(DISTINCT oem_code) FROM ups_batteries.gold.oem_lookup) AS oem_codes FROM ups_batteries.gold.battery_catalog"
      ]
    },
    {
      "name": "ds_voltage",
      "displayName": "Batteries by voltage",
      "queryLines": [
        "SELECT CONCAT(voltage_v, ' V') AS voltage, COUNT(*) AS batteries FROM ups_batteries.gold.battery_catalog WHERE voltage_v IS NOT NULL GROUP BY voltage_v ORDER BY voltage_v"
      ]
    },
    {
      "name": "ds_price_capacity",
      "displayName": "Price vs capacity",
      "queryLines": [
        "SELECT title, capacity_ah, price_eur, CONCAT(voltage_v, ' V') AS voltage FROM ups_batteries.gold.battery_catalog WHERE capacity_ah IS NOT NULL AND price_eur IS NOT NULL"
      ]
    },
    {
      "name": "ds_brand",
      "displayName": "Brands",
      "queryLines": [
        "SELECT brand, COUNT(*) AS batteries, ROUND(AVG(price_eur), 2) AS avg_price_eur FROM ups_batteries.gold.battery_catalog WHERE brand IS NOT NULL GROUP BY brand ORDER BY batteries DESC"
      ]
    },
    {
      "name": "ds_devices",
      "displayName": "Devices per brand",
      "queryLines": [
        "SELECT device_brand, COUNT(DISTINCT device_title) AS devices FROM ups_batteries.gold.device_lookup WHERE device_brand IS NOT NULL GROUP BY device_brand ORDER BY devices DESC LIMIT 15"
      ]
    },
    {
      "name": "ds_catalog",
      "displayName": "Catalog",
      "queryLines": [
        "SELECT brand, model, voltage_v, capacity_ah, length_mm, width_mm, height_mm, terminal, chemistry, pack_units, price_eur, availability FROM ups_batteries.gold.battery_catalog ORDER BY voltage_v, capacity_ah"
      ]
    }
  ],
  "pages": [
    {
      "name": "page_main",
      "displayName": "UPS Battery Catalog",
      "layout": [
